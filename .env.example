# Copy to .env.local for development, or set these in Vercel → Project → Settings → Environment Variables.
# Every variable is optional — the site works without them and unlocks features as you add them.

# ----- Orders database (Supabase → free tier) -----
# Create a project at https://supabase.com, run the SQL from the README, then paste:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Admin dashboard (/admin) -----
ADMIN_PASSWORD=

# ----- Email notification for each new order (https://resend.com, free tier) -----
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
# Optional custom sender (defaults to onboarding@resend.dev):
# ORDER_NOTIFY_FROM="OFFside Orders <orders@yourdomain.com>"

# ----- Customer-visible contact & payment numbers -----
# WhatsApp number with country code, digits only (e.g. 8801XXXXXXXXX):
NEXT_PUBLIC_WHATSAPP_NUMBER=
# bKash / Nagad numbers shown at checkout for Send Money:
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_NAGAD_NUMBER=

# ----- SSLCommerz online payment gateway (optional) -----
# Register at https://sslcommerz.com, then:
# NEXT_PUBLIC_SSLCOMMERZ_ENABLED=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_LIVE=true   # leave unset to use the sandbox
