# Copy to .env.local for development, or set these in Vercel → Project → Settings → Environment Variables.
# Every variable is optional — the site works without them and unlocks features as you add them.

# ----- Orders database (Supabase → free tier) -----
# Create a project at https://supabase.com, run the SQL from the README, then paste:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Admin dashboard (/admin) -----
ADMIN_PASSWORD=

# ----- Email notification for each new order (AWS SES) -----
# SES console → SMTP settings → Create SMTP credentials. The sender address
# must be a verified identity in SES; in sandbox mode recipients must be
# verified too (request production access to email real customers).
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Region the SMTP credentials were created in (e.g. ap-southeast-2):
AWS_SES_REGION=
# Where new-order notifications go; also the default sender:
ORDER_NOTIFY_EMAIL=
# Optional custom sender — must be a verified identity in SES:
# ORDER_EMAIL_FROM="OFFside <orders@yourdomain.com>"

# ----- Customer-visible contact & payment numbers -----
# WhatsApp number with country code, digits only (e.g. 8801XXXXXXXXX):
NEXT_PUBLIC_WHATSAPP_NUMBER=
# bKash / Nagad numbers shown at checkout for Send Money:
NEXT_PUBLIC_BKASH_NUMBER=
NEXT_PUBLIC_NAGAD_NUMBER=

# ----- SSLCommerz online payment gateway (optional) -----
# Register at https://sslcommerz.com, then:
# NEXT_PUBLIC_SSLCOMMERZ_ENABLED=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_LIVE=true   # leave unset to use the sandbox

# Easiest free email that lands in the INBOX (no domain needed) — Gmail SMTP.
# Google Account -> Security -> 2-Step Verification -> App passwords:
GMAIL_USER=
GMAIL_APP_PASSWORD=
